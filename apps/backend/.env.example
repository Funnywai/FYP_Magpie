# Copy to .env and fill in from Supabase Dashboard → Project Settings → API.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# WARNING: service_role bypasses RLS. Server-side only — never ship to the mobile bundle.
SUPABASE_SERVICE_ROLE_KEY=
PORT=8787

# Instagram capture policy: video_first (default) or never.
MAGPIE_IG_MEDIA_POLICY=video_first
